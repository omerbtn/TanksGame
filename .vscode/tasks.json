{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure CMake",
      "type": "shell",
      "command": "cmake -S . -B build",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CC": "gcc-12",
          "CXX": "g++-12"
        }
      }
    },
    {
      "label": "Build Project",
      "type": "shell",
      "dependsOn": [
        "Configure CMake"
      ],
      "command": "cmake --build build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CC": "gcc-12",
          "CXX": "g++-12"
        }
      },
      "detail": "Generated task for building the project"
    }
  ]
}